# Safe local defaults. Copy to your shell environment; do not commit secrets.
HOST=127.0.0.1
PORT=4178
OPENBOT_LOCAL_ONLY=1
OPENBOT_DATA_DIR=./data
OPENBOT_OLLAMA_URL=http://127.0.0.1:11434
# Optional: comma-separated HTTPS hosts for browser.fetch when local-only is off.
OPENBOT_BROWSER_ALLOWLIST=
OPENBOT_MAX_BODY_BYTES=65536
OPENBOT_MAX_PROMPT_BYTES=16384
OPENBOT_SHELL_TIMEOUT_MS=30000
# Linux production default is required. Use allowlist only on a trusted development host.
OPENBOT_SANDBOX_MODE=required
